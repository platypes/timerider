{
  "name": "timerider",
  "version": "0.2.0",
  "description": "Accurate timers with drift correction, pause/resume, and long delay support.",
  "keywords": [
    "timer",
    "timeout",
    "interval",
    "drift-correction",
    "pause",
    "resume",
    "long-delay",
    "deno",
    "npm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/platypes/timerider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platypes/timerider.git"
  },
  "bugs": {
    "url": "https://github.com/platypes/timerider/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "biome check . && tsc --noEmit",
    "fix": "biome check --write .",
    "build": "tsc",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
